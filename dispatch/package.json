{
  "name": "myregiocar-vermittlung",
  "private": true,
  "type": "module",
  "description": "Vermittelt Fahrauftraege per Telegram an die Fahrer von MyRegioCar",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:anlegen": "wrangler d1 execute vermittlung --file=schema.sql --remote",
    "db:lokal": "wrangler d1 execute vermittlung --file=schema.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.101.0"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  }
}
