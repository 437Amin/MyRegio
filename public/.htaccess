# =============================================================================
#  Servereinstellungen fuer Hostinger (Apache / LiteSpeed)
#
#  Diese Datei wird beim Bauen automatisch mit hochgeladen.
#  Sie muss normalerweise nie angefasst werden.
# =============================================================================

# --- Eigene Fehlerseite statt der nackten Apache-Meldung ---------------------
ErrorDocument 404 /404.html

# --- Immer verschluesselt ausliefern ----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Falls die Seite spaeter OHNE www laufen soll, die naechsten zwei Zeilen
  # entkommentieren (fuehrendes # entfernen). Wichtig: Es darf immer nur EINE
  # Schreibweise gelten, sonst wertet Google die Seite doppelt.
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Sicherheits-Kopfzeilen --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Gebaute Dateien tragen einen Namensstempel und duerfen lange
  # zwischengespeichert werden
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML dagegen immer frisch holen, damit Aenderungen sofort sichtbar sind
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Komprimierung -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Verzeichnisinhalte nicht auflisten --------------------------------------
Options -Indexes
