# =============================================================================
#  Kopfzeilen fuer Cloudflare
#
#  Diese Datei ersetzt, was frueher in public/.htaccess stand. Einen
#  Apache-Server gibt es hier nicht mehr - Cloudflare liest stattdessen
#  diese Datei.
#
#  Sie muss normalerweise nie angefasst werden.
#
#  Nicht mehr noetig, weil Cloudflare es von sich aus erledigt:
#    - HTTPS erzwingen
#    - Komprimierung
#    - eigene 404-Seite (siehe not_found_handling in wrangler.toml)
#    - Verzeichnisinhalte nicht auflisten
#
#  ACHTUNG, Stolperfalle: Passen mehrere Regeln auf eine Adresse, haengt
#  Cloudflare die Werte ANEINANDER, statt den spaeteren zu nehmen. Eine
#  Kopfzeile darf deshalb nie in zwei Regeln stehen, die sich ueberlappen -
#  sonst steht dort zum Beispiel "max-age=0, ..., max-age=31536000" und der
#  Browser weiss nicht, was gilt.
# =============================================================================

# --- Gilt fuer jede Seite ----------------------------------------------------
# Bewusst OHNE Cache-Control: Fuer HTML liefert Cloudflare von sich aus
# "public, max-age=0, must-revalidate". Inhaltliche Aenderungen sind damit
# sofort sichtbar.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# --- Gebaute Dateien ---------------------------------------------------------
# Alles unter /_astro/ traegt einen Namensstempel im Dateinamen (Schriften,
# Stylesheets, Skripte). Aendert sich der Inhalt, aendert sich der Name.
# Deshalb darf das ein Jahr lang zwischengespeichert werden.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
