---
import type { IconName } from './icon-namen';

/**
 * Alle Symbole der Website an einer Stelle.
 * Duenne Linien im Stil des vorhandenen MyRegioCar-Flyers.
 */
interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: klasse = '', size = 24 } = Astro.props;

// WhatsApp ist ein Flaechen-Logo, alle anderen sind Strich-Symbole.
const istFlaeche = name === 'whatsapp';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={istFlaeche ? 'currentColor' : 'none'}
  stroke={istFlaeche ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={klasse}
  aria-hidden="true"
  focusable="false"
>
  {name === 'flugzeug' && <path d="M17.8 19.2 16 11l3.5-3.5a2.1 2.1 0 0 0-3-3L13 8 4.8 6.2a.5.5 0 0 0-.5.8l3.2 3.9-2 2H3.2a.5.5 0 0 0-.35.85l2.1 2.1 2.1 2.1a.5.5 0 0 0 .85-.35V15.5l2-2 3.9 3.2a.5.5 0 0 0 .8-.5Z" />}

  {name === 'herz' && <path d="M20.4 5.6a5.4 5.4 0 0 0-7.7 0L12 6.3l-.7-.7a5.4 5.4 0 1 0-7.7 7.7l.7.7L12 21.7l7.7-7.7.7-.7a5.4 5.4 0 0 0 0-7.7Z" />}

  {name === 'aktentasche' && (
    <>
      <rect x="2" y="7" width="20" height="14" rx="2" />
      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M2 13h20" />
    </>
  )}

  {name === 'paket' && (
    <>
      <path d="m7.5 4.27 9 5.15M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
      <path d="m3.3 7 8.7 5 8.7-5M12 22V12" />
    </>
  )}

  {name === 'stern' && <path d="M11.5 2.9a.6.6 0 0 1 1 0l2.4 5.2 5.6.7a.6.6 0 0 1 .3 1l-4.1 3.9 1.1 5.6a.6.6 0 0 1-.9.6L12 17.2l-4.9 2.7a.6.6 0 0 1-.9-.6l1.1-5.6-4.1-3.9a.6.6 0 0 1 .3-1l5.6-.7Z" />}

  {name === 'route' && (
    <>
      <circle cx="6" cy="19" r="2.5" />
      <circle cx="18" cy="5" r="2.5" />
      <path d="M15.5 5H9a3 3 0 0 0 0 6h6a3 3 0 0 1 0 6H8.5" />
    </>
  )}

  {name === 'parken' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="M9.5 17V7.5h3.2a2.9 2.9 0 0 1 0 5.8H9.5" />
    </>
  )}

  {name === 'whatsapp' && (
    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.13-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.38-1.99-1.23-.74-.65-1.24-1.46-1.38-1.71-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.55-.42-.14-.01-.31-.01-.47-.01-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.73 2.64 4.19 3.7.59.26 1.04.41 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29Z" />
