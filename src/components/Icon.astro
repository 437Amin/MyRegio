  {name === 'haendedruck' && <path d="M11 6.5 8.6 8.9a2 2 0 0 0 0 2.8 2 2 0 0 0 2.8 0l1.4-1.4 3.6 3.6a1.7 1.7 0 0 1-2.4 2.4l-.6-.6.6.6a1.7 1.7 0 0 1-2.4 2.4l-.6-.6.6.6a1.7 1.7 0 1 1-2.4 2.4L6.4 18M2.5 8.5l3-3M21.5 8.5l-3-3M18.5 5.5 15 9M5.5 5.5 9 9" />}

  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>
