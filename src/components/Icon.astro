  {name === 'mail' && (
    <>
      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
      <path d="m3 7 8.1 5.6a1.6 1.6 0 0 0 1.8 0L21 7" />
    </>
  )}

  {name === 'uhr' && (
    <>
      <circle cx="12" cy="12" r="9.5" />
      <path d="M12 6.8V12l3.4 2" />
    </>
  )}

  {name === 'pin' && (
    <>
      <path d="M20 10.5c0 5.5-8 12-8 12s-8-6.5-8-12a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10.3" r="2.9" />
    </>
  )}

  {name === 'check' && <path d="m4.5 12.5 5 5 10-11" />}

  {name === 'bahn' && (
    <>
      <rect x="5" y="2.8" width="14" height="13.4" rx="3" />
      <path d="M5 10h14M8 21l-2 1.5M16 21l2 1.5M7.5 16.2h9" />
      <circle cx="9" cy="13.1" r=".9" fill="currentColor" stroke="none" />
      <circle cx="15" cy="13.1" r=".9" fill="currentColor" stroke="none" />
    </>
  )}

  {name === 'schild' && (
    <>
      <path d="M12 2.5 4.5 5.6v5.9c0 4.7 3.2 9 7.5 10.1 4.3-1.1 7.5-5.4 7.5-10.1V5.6Z" />
      <path d="m9 12 2.2 2.2L15.4 10" />
    </>
  )}

  {name === 'menue' && <path d="M4 7h16M4 12h16M4 17h16" />}

  {name === 'schliessen' && <path d="M6 6l12 12M18 6 6 18" />}

  {name === 'pfeil-rechts' && <path d="M4.5 12h15m-6-6 6 6-6 6" />}

  {name === 'pfeil-links' && <path d="M19.5 12h-15m6-6-6 6 6 6" />}

  {name === 'personen' && (
    <>
      <circle cx="9" cy="8" r="3.4" />
      <path d="M2.8 20.2a6.2 6.2 0 0 1 12.4 0M16.5 5.2a3.4 3.4 0 0 1 0 6.6M17.8 14.5a6.2 6.2 0 0 1 3.4 5.7" />
    </>
  )}

  {name === 'gepaeck' && (
    <>
      <rect x="3.5" y="7.5" width="17" height="12.5" rx="2.5" />
