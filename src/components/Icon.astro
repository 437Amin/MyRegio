  {name === 'kalender' && (
    <>
      <rect x="3.5" y="5" width="17" height="16" rx="2.5" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </>
  )}

  {name === 'euro' && (
    <>
      <circle cx="12" cy="12" r="9.5" />
      <path d="M15.5 8.2a4.3 4.3 0 0 0-6.9 1.6M15.5 15.8a4.3 4.3 0 0 1-6.9-1.6M7 11h6M7 13.5h6" />
    </>
  )}

  {name === 'ausweis' && (
    <>
      <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
      <circle cx="8.5" cy="11" r="2.1" />
      <path d="M5.2 16.2a3.6 3.6 0 0 1 6.6 0M14.5 10h4.2M14.5 13.4h4.2" />
    </>
  )}

  {name === 'dokument' && (
    <>
      <path d="M14 2.8H7a2 2 0 0 0-2 2v14.4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.8Z" />
      <path d="M14 2.8V7.8h5M8.5 13h7M8.5 16.5h4.5" />
