---
import Icon from './Icon.astro';
import {
  site,
  telefonLink,
  bestellungenLink,
  whatsappLink,
  whatsappStandardtext,
  vermittlungAktiv,
  vermittlungAdresse,
} from '~/config/site';

interface Props {
  /** Fahrtart schon vorwählen, z. B. "park-and-fly" auf der Park-&-Fly-Seite */
  vorauswahl?: string;
  ueberschrift?: string;
  einleitung?: string;
  id?: string;
}

const {
  vorauswahl = '',
  ueberschrift = 'Fahrt anfragen – in unter einer Minute',
  einleitung = 'Beantworten Sie ein paar kurze Fragen. Am Ende öffnet sich WhatsApp mit einer fertig geschriebenen Nachricht – Sie müssen sie nur noch abschicken.',
  id = 'buchen',
} = Astro.props;

const fahrtarten = [
  { wert: 'Flughafentransfer', icon: 'flugzeug' as const },
  { wert: 'Park & Fly', icon: 'parken' as const },
  { wert: 'Stadt- oder Überlandfahrt', icon: 'route' as const },
  { wert: 'Krankenfahrt', icon: 'herz' as const },
  { wert: 'Geschäftsfahrt', icon: 'aktentasche' as const },
  { wert: 'Kurierfahrt', icon: 'paket' as const },
];

const schritte = ['Anlass', 'Strecke', 'Termin', 'Details', 'Absenden'];
---

<section id={id} class="abschnitt scroll-mt-24">
  <div class="huelle">
    <div class="mx-auto max-w-3xl text-center">
      <span class="augenbraue">
        <Icon name="whatsapp" size={15} />
        Buchung ohne Anruf
      </span>
      <h2 class="mt-4 text-3xl md:text-4xl">{ueberschrift}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-nebel-400">{einleitung}</p>
    </div>

    <!-- Ohne JavaScript: direkte Kontaktwege statt eines toten Formulars -->
    <div class="assistent-ersatz mx-auto mt-10 max-w-2xl">
      <div class="karte p-6 text-center">
        <p class="text-nebel-300">
          Schreiben Sie uns einfach direkt – wir melden uns umgehend mit einem
          Festpreis zurück.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a
            href={whatsappLink(whatsappStandardtext)}
            target="_blank"
            rel="noopener"
            class="knopf knopf-whatsapp w-full"
          >
            <Icon name="whatsapp" size={20} />
            WhatsApp öffnen
          </a>
          <a href={telefonLink} class="knopf knopf-rand w-full">
            <Icon name="telefon" size={18} />
            {site.kontakt.telefonAnzeige}
          </a>
        </div>
      </div>
    </div>

    <div
      class="assistent mx-auto mt-10 max-w-3xl"
      data-assistent
      data-whatsapp={site.kontakt.whatsapp}
      data-vorauswahl={vorauswahl}
      data-marke={site.unternehmen.marke}
      data-vermittlung={vermittlungAktiv ? vermittlungAdresse : ''}
    >
      <!-- Fortschritt -->
      <ol class="mb-6 flex items-center gap-1.5" aria-hidden="true">
        {
          schritte.map((name, index) => (
            <li class="flex flex-1 flex-col gap-1.5">
              <span
                class="h-1 rounded-full bg-white/10 transition-colors duration-300"
                data-fortschritt={index + 1}
              />
              <span
                class="hidden text-[0.7rem] font-medium text-nebel-500 transition-colors sm:block"
                data-fortschritt-text={index + 1}
              >
                {name}
              </span>
            </li>
          ))
        }
      </ol>

      <form class="karte p-5 md:p-7" data-formular novalidate>
        <p class="nur-vorlesen" role="status" aria-live="polite" data-ansage></p>

        <!-- ============================ Schritt 1 ============================ -->
        <fieldset data-schritt="1" hidden>
          <legend class="text-xl font-bold text-white md:text-2xl" tabindex="-1">
            Worum geht es?
          </legend>
          <p class="mt-2 text-sm text-nebel-400">
            Wählen Sie den passenden Anlass – die nächsten Fragen richten sich
            danach.
          </p>

          <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
            {
              fahrtarten.map((art) => (
                <label class="auswahl-karte">
                  <input
                    type="radio"
                    name="art"
                    value={art.wert}
                    class="peer sr-only"
                    checked={vorauswahl === art.wert}
                  />
                  <span class="auswahl-inhalt">
                    <span class="icon-rahmen !h-10 !w-10">
                      <Icon name={art.icon} size={20} />
                    </span>
                    <span class="font-semibold">{art.wert}</span>
                    <span class="haken">
                      <Icon name="check" size={14} />
                    </span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- ============================ Schritt 2 ============================ -->
        <fieldset data-schritt="2" hidden>
          <legend class="text-xl font-bold text-white md:text-2xl" tabindex="-1">
            <span data-nur-art="Park & Fly">Ihr Fahrzeug</span>
            <span data-ohne-art="Park & Fly">Wohin soll es gehen?</span>
          </legend>

          <!-- Normale Fahrten -->
          <div class="mt-5 space-y-4" data-ohne-art="Park & Fly">
            <div class="feld vorschlagfeld" data-vorschlagfeld="von">
              <label for="feld-von">Abholadresse</label>
              <input
                id="feld-von"
                name="von"
                type="text"
                autocomplete="off"
                enterkeyhint="next"
                placeholder="Straße, Hausnummer, Ort"
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="vorschlaege-von"
              />
              <ul class="vorschlaege" id="vorschlaege-von" role="listbox" hidden></ul>
              <input type="hidden" name="vonBreite" />
              <input type="hidden" name="vonLaenge" />
              <p class="hilfe">Bitte aus den Vorschlägen auswählen – nur dann können wir einen Festpreis nennen.</p>
            </div>

            <div class="feld vorschlagfeld" data-vorschlagfeld="nach">
              <label for="feld-nach">Zieladresse</label>
              <input
                id="feld-nach"
                name="nach"
                type="text"
                autocomplete="off"
                enterkeyhint="next"
                placeholder="z. B. Flughafen Stuttgart"
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="vorschlaege-nach"
              />
              <ul class="vorschlaege" id="vorschlaege-nach" role="listbox" hidden></ul>
              <input type="hidden" name="nachBreite" />
              <input type="hidden" name="nachLaenge" />
            </div>
            <label class="schalter">
              <input type="checkbox" name="rueckfahrt" />
              <span>Ich brauche auch eine Rückfahrt</span>
            </label>
          </div>

          <!-- Park & Fly -->
          <div class="mt-5 space-y-4" data-nur-art="Park & Fly" hidden>
            <p class="text-sm text-nebel-400">
              Sie stellen Ihr Auto bei uns in der {site.unternehmen.strasse} ab.
              Von dort sind es {site.anfahrt.fussMinuten} Gehminuten bis zur
              Haltestelle {site.anfahrt.haltestelle}.
            </p>
            <div class="feld">
              <label for="feld-kennzeichen">Kennzeichen Ihres Fahrzeugs</label>
              <input
                id="feld-kennzeichen"
                name="kennzeichen"
                type="text"
                autocapitalize="characters"
                enterkeyhint="next"
                placeholder="z. B. S-AB 1234"
              />
            </div>
            <div class="feld">
              <label for="feld-fahrzeug">Fahrzeugmodell und Farbe</label>
              <input
                id="feld-fahrzeug"
                name="fahrzeug"
                type="text"
                enterkeyhint="next"
                placeholder="z. B. VW Golf, dunkelblau"
              />
            </div>
            <label class="schalter">
              <input type="checkbox" name="shuttle" />
              <span>
                Ich möchte zusätzlich den Shuttle bis vor das Terminal
              </span>
            </label>
          </div>
        </fieldset>

        <!-- ============================ Schritt 3 ============================ -->
        <fieldset data-schritt="3" hidden>
          <legend class="text-xl font-bold text-white md:text-2xl" tabindex="-1">
            <span data-nur-art="Park & Fly">Wann geht Ihr Flug?</span>
            <span data-ohne-art="Park & Fly">Wann sollen wir da sein?</span>
          </legend>

          <!-- Merkt sich, ob "so bald wie möglich" gewählt wurde -->
          <input type="hidden" name="sofort" value="" />

          <div class="mt-5 flex flex-wrap gap-2" data-ohne-art="Park & Fly">
            <button type="button" class="chip" data-schnellwahl="jetzt">
              So bald wie möglich
            </button>
            <button type="button" class="chip" data-schnellwahl="heute-abend">
              Heute Abend
            </button>
            <button type="button" class="chip" data-schnellwahl="morgen-frueh">
              Morgen früh
            </button>
          </div>

          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            <div class="feld">
              <label for="feld-datum">
                <span data-nur-art="Park & Fly">Auto abstellen am</span>
                <span data-ohne-art="Park & Fly">Datum</span>
              </label>
              <input id="feld-datum" name="datum" type="date" />
            </div>
            <div class="feld">
              <label for="feld-zeit">Uhrzeit</label>
              <input id="feld-zeit" name="zeit" type="time" step="300" />
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2" data-nur-art="Park & Fly" hidden>
            <div class="feld">
              <label for="feld-rueckkehr">Voraussichtliche Rückkehr am</label>
              <input id="feld-rueckkehr" name="rueckkehr" type="date" />
            </div>
            <div class="feld">
              <label for="feld-rueckzeit">Uhrzeit der Rückkehr</label>
              <input id="feld-rueckzeit" name="rueckzeit" type="time" step="300" />
            </div>
          </div>

          <div class="mt-4 space-y-4" data-ohne-art="Park & Fly">
            <div class="feld" data-nur-art="Flughafentransfer" hidden>
              <label for="feld-flug">Flugnummer <span class="opt">optional</span></label>
              <input
                id="feld-flug"
                name="flugnummer"
                type="text"
                autocapitalize="characters"
                placeholder="z. B. LH 1234"
              />
              <p class="hilfe">
                Damit behalten wir Ihre tatsächliche Ankunftszeit im Blick.
              </p>
            </div>
          </div>
        </fieldset>

        <!-- ============================ Schritt 4 ============================ -->
        <fieldset data-schritt="4" hidden>
          <legend class="text-xl font-bold text-white md:text-2xl" tabindex="-1">
            Wer fährt mit?
          </legend>

          <div class="mt-5 space-y-3">
            <div class="zaehler" data-zaehler="personen" data-min="1" data-max="8">
              <span class="zaehler-titel">
                <Icon name="personen" size={18} class="text-cyan-500" />
                Personen
              </span>
              <div class="zaehler-bedienung">
                <button type="button" data-minus aria-label="Weniger Personen">−</button>
                <output data-wert>1</output>
                <button type="button" data-plus aria-label="Mehr Personen">+</button>
              </div>
              <input type="hidden" name="personen" value="1" />
            </div>

            <div class="zaehler" data-zaehler="gepaeck" data-min="0" data-max="10">
              <span class="zaehler-titel">
                <Icon name="gepaeck" size={18} class="text-cyan-500" />
                Gepäckstücke
              </span>
              <div class="zaehler-bedienung">
                <button type="button" data-minus aria-label="Weniger Gepäck">−</button>
                <output data-wert>0</output>
                <button type="button" data-plus aria-label="Mehr Gepäck">+</button>
              </div>
              <input type="hidden" name="gepaeck" value="0" />
            </div>

            <div class="zaehler" data-zaehler="kindersitze" data-min="0" data-max="4">
              <span class="zaehler-titel">
                <Icon name="schild" size={18} class="text-cyan-500" />
                Kindersitze
              </span>
              <div class="zaehler-bedienung">
                <button type="button" data-minus aria-label="Weniger Kindersitze">−</button>
                <output data-wert>0</output>
                <button type="button" data-plus aria-label="Mehr Kindersitze">+</button>
              </div>
              <input type="hidden" name="kindersitze" value="0" />
            </div>
          </div>

          <div class="feld mt-5">
            <label for="feld-anmerkung">
              Anmerkung <span class="opt">optional</span>
            </label>
            <textarea
              id="feld-anmerkung"
              name="anmerkung"
              rows="3"
              placeholder="z. B. Rollator dabei, bitte klingeln, Firmenrechnung gewünscht"
            ></textarea>
          </div>
        </fieldset>

        <!-- ============================ Schritt 5 ============================ -->
        <fieldset data-schritt="5" hidden>
          <legend class="text-xl font-bold text-white md:text-2xl" tabindex="-1">
            Fast geschafft
          </legend>

          <div class="feld mt-5">
            <label for="feld-name">Ihr Name</label>
            <input
              id="feld-name"
              name="name"
              type="text"
              autocomplete="name"
              enterkeyhint="next"
              placeholder="Vor- und Nachname"
            />
          </div>

          <div class="feld mt-4">
            <label for="feld-telefon">
              Ihre Telefonnummer
              {!vermittlungAktiv && <span class="opt">optional</span>}
            </label>
            <input
              id="feld-telefon"
              name="telefon"
              type="tel"
              inputmode="tel"
              autocomplete="tel"
              enterkeyhint="done"
              placeholder="z. B. 0171 2345678"
            />
            <p class="hilfe">Damit der Fahrer Sie erreichen kann.</p>
          </div>

          <div class="mt-6">
            <h3 class="text-sm font-bold uppercase tracking-widest text-nebel-500">
              Das schicken wir ab
            </h3>
            <pre
              class="mt-3 max-h-60 overflow-auto whitespace-pre-wrap rounded-xl border border-white/10 bg-nacht-950/60 p-4 font-sans text-sm leading-relaxed text-nebel-300"
              data-vorschau>…</pre>
          </div>

          <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-nebel-500">
            <Icon name="schild" size={15} class="mt-px shrink-0 text-cyan-600" />
            <span>
              {
                vermittlungAktiv
                  ? 'Ihre Angaben bleiben bis hierhin in Ihrem Browser. Mit „Jetzt Fahrer anfordern“ übermitteln Sie sie an uns, damit wir einen Fahrer suchen können. Wählen Sie stattdessen WhatsApp, entscheiden Sie selbst, wann Sie die Nachricht abschicken.'
                  : 'Ihre Angaben bleiben bis hierhin ausschließlich in Ihrem Browser. Erst wenn Sie auf den Knopf tippen, öffnet sich WhatsApp mit dem obigen Text – abgeschickt wird er von Ihnen.'
              }
            </span>
          </p>
        </fieldset>

        <!-- Festpreis -->
        <div class="preisfeld mt-6" data-preisfeld hidden>
          <div class="flex items-center gap-3" data-preis-laedt>
            <span class="sucher-klein" aria-hidden="true"></span>
            <span class="text-sm text-nebel-400">Festpreis wird berechnet …</span>
          </div>

          <div data-preis-fertig hidden>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <span class="text-sm font-semibold uppercase tracking-widest text-cyan-400">
                Ihr Festpreis
              </span>
              <span class="font-display text-3xl font-bold text-white" data-preis-betrag></span>
            </div>
            <p class="mt-1 text-sm text-nebel-400">
              ca. <span data-preis-km></span> km · rund <span data-preis-dauer></span> Minuten Fahrt
            </p>
            <dl class="mt-3 space-y-0.5 border-t border-white/8 pt-3 text-xs text-nebel-500">
              <div><dt class="inline">Ab</dt> <dd class="inline text-nebel-300" data-preis-von></dd></div>
              <div><dt class="inline">Bis</dt> <dd class="inline text-nebel-300" data-preis-nach></dd></div>
            </dl>
            <p class="mt-2 text-xs text-nebel-500">
              Stimmen die Adressen nicht? Gehen Sie zurück und korrigieren Sie sie –
              der Preis gilt für die hier genannte Strecke.
            </p>
          </div>

          <div data-preis-anfrage hidden>
            <span class="text-sm font-semibold uppercase tracking-widest text-nebel-400">
              Preis auf Anfrage
            </span>
            <p class="mt-1 text-sm text-nebel-400">
              Diese Strecke können wir nicht automatisch berechnen. Wir nennen
              Ihnen den Festpreis direkt – vor der Fahrt und verbindlich.
            </p>
          </div>
        </div>

        <!-- Fehlerhinweis -->
        <p
          class="mt-4 hidden items-start gap-2 rounded-lg border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-sm text-red-200"
          data-fehler
          role="alert"
        >
        </p>

        <!-- Steuerung -->
        <div class="mt-6 flex items-center gap-3 border-t border-white/8 pt-5">
          <button type="button" class="knopf knopf-rand !px-4" data-zurueck hidden>
            <Icon name="pfeil-links" size={18} />
            <span class="nur-vorlesen">Zurück</span>
          </button>

          <button type="button" class="knopf knopf-cyan flex-1" data-weiter>
            Weiter
            <Icon name="pfeil-rechts" size={18} />
          </button>

          {
            vermittlungAktiv && (
              <button type="button" class="knopf knopf-cyan flex-1" data-vermitteln hidden>
                <Icon name="pfeil-rechts" size={18} />
                Jetzt Fahrer anfordern
              </button>
            )
          }

          <a
            class:list={[
              'knopf knopf-whatsapp',
              vermittlungAktiv ? '!px-4' : 'flex-1',
            ]}
            data-senden
            href={whatsappLink(whatsappStandardtext)}
            target="_blank"
            rel="noopener"
            hidden
          >
            <Icon name="whatsapp" size={20} />
            <span class:list={[vermittlungAktiv && 'hidden sm:inline']}>
              {vermittlungAktiv ? 'WhatsApp' : 'Per WhatsApp senden'}
            </span>
          </a>
        </div>

        <!-- Alternativen, falls WhatsApp nicht genutzt wird -->
        <div class="mt-4 hidden text-center text-sm text-nebel-500" data-alternativen>
          Kein WhatsApp?
          <a href={telefonLink} class="text-cyan-400 underline underline-offset-4">
            Anrufen
          </a>
          oder
          <a data-mailto href={bestellungenLink} class="text-cyan-400 underline underline-offset-4">
            per E-Mail senden
          </a>
        </div>
      </form>

      <!-- Erscheint anstelle des Formulars, sobald ein Fahrer gesucht wird -->
      <div class="karte p-6 text-center md:p-9" data-status hidden>
        <!-- Suche läuft -->
        <div data-status-suche>
          <span class="sucher mx-auto" aria-hidden="true"></span>
          <h3 class="mt-6 text-xl font-bold text-white md:text-2xl">
            Wir suchen einen Fahrer für Sie
          </h3>
          <p class="mx-auto mt-3 max-w-md text-nebel-400">
            Das dauert meist weniger als eine Minute. Bitte lassen Sie diese
            Seite so lange geöffnet.
          </p>
        </div>

        <!-- Fahrer gefunden -->
        <div data-status-gefunden hidden>
          <span class="icon-rahmen mx-auto !h-14 !w-14 !border-green-500/50 !bg-green-500/10 !text-green-400">
            <Icon name="check" size={26} />
          </span>
          <h3 class="mt-5 text-xl font-bold text-white md:text-2xl">
            <span data-fahrername>Ein Fahrer</span> übernimmt Ihre Fahrt
          </h3>
          <p class="mx-auto mt-3 max-w-md text-nebel-400">
            Sie werden bei Bedarf kurz angerufen. Bezahlt wird bar oder mit
            Karte im Fahrzeug.
          </p>
        </div>

        <!-- Niemand frei -->
        <div data-status-keiner hidden>
          <span class="icon-rahmen mx-auto !h-14 !w-14">
            <Icon name="telefon" size={24} />
          </span>
          <h3 class="mt-5 text-xl font-bold text-white md:text-2xl">
            Gerade ist kein Fahrer frei
          </h3>
          <p class="mx-auto mt-3 max-w-md text-nebel-400">
            Ihre Anfrage liegt uns vor. Am schnellsten geht es jetzt telefonisch
            – wir finden eine Lösung.
          </p>
          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
            <a href={telefonLink} class="knopf knopf-cyan">
              <Icon name="telefon" size={18} />
              {site.kontakt.telefonAnzeige}
            </a>
            <a
              data-status-whatsapp
              href={whatsappLink(whatsappStandardtext)}
              target="_blank"
              rel="noopener"
              class="knopf knopf-rand"
            >
              <Icon name="whatsapp" size={18} />
              WhatsApp
            </a>
          </div>
        </div>

        <!-- Technischer Fehler -->
        <div data-status-fehler hidden>
          <span class="icon-rahmen mx-auto !h-14 !w-14">
            <Icon name="schild" size={24} />
          </span>
          <h3 class="mt-5 text-xl font-bold text-white md:text-2xl">
            Das hat leider nicht geklappt
          </h3>
          <p class="mx-auto mt-3 max-w-md text-nebel-400">
            Ihre Anfrage konnte nicht übermittelt werden. Bitte rufen Sie uns an
            oder schreiben Sie uns – Ihre Angaben sind noch ausgefüllt.
          </p>
          <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
            <a href={telefonLink} class="knopf knopf-cyan">
              <Icon name="telefon" size={18} />
              {site.kontakt.telefonAnzeige}
            </a>
            <a
              data-status-whatsapp
              href={whatsappLink(whatsappStandardtext)}
              target="_blank"
              rel="noopener"
              class="knopf knopf-whatsapp"
            >
              <Icon name="whatsapp" size={18} />
              Per WhatsApp senden
            </a>
          </div>
          <button type="button" class="knopf knopf-rand mt-4" data-zurueck-formular>
            Zurück zum Formular
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Der Assistent erscheint nur, wenn JavaScript laeuft. Sonst bleibt der
     direkte Kontaktweg darueber stehen - nie ein totes Formular. */
  .assistent {
    display: none;
  }
  :global(html.js) .assistent {
    display: block;
  }
  :global(html.js) .assistent-ersatz {
    display: none;
  }

  /* --- Auswahlkarten (Schritt 1) --- */
  .auswahl-karte {
    display: block;
    cursor: pointer;
  }

  .auswahl-inhalt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.875rem;
    background-color: rgb(255 255 255 / 0.025);
    color: var(--color-nebel-100);
    font-size: 0.9375rem;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .auswahl-karte:hover .auswahl-inhalt {
